# Replace with a randomly generated URL-safe value. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
# Loopback development only. Use HTTPS and set the insecure flag to 0 behind a production TLS proxy.
AEK_PUBLIC_ORIGIN=http://127.0.0.1:8787
AEK_ALLOW_INSECURE_LOCALHOST=1
